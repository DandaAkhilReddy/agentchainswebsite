{
  "name": "msjobs2linkedin-api",
  "version": "1.0.0",
  "description": "Azure Functions pipeline that turns fresh Microsoft job postings into ready-to-paste LinkedIn posts.",
  "type": "module",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist output",
    "prestart": "npm run build",
    "start": "func start",
    "digest": "tsx src/scripts/digest.ts",
    "digest:build": "npm run build && node dist/src/scripts/digest.js"
  },
  "dependencies": {
    "@azure/functions": "^4.5.1",
    "@azure/storage-blob": "^12.24.0"
  },
  "optionalDependencies": {
    "@azure/communication-email": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
