# ------------------------------------------------------------------
# msjobs2linkedin — configuration
# Copy to api/local.settings.json (see api/local.settings.json.example)
# or set these as Application Settings on the Azure Function App.
# Everything has a sensible default; nothing here is strictly required
# to run the local CLI.
# ------------------------------------------------------------------

# --- What jobs to pull -------------------------------------------------------
# Free-text search query sent to the Microsoft careers API (e.g. "Software Engineer").
# Leave blank to pull everything and rely on the filters below.
MSJOBS_QUERY=Software Engineer

# Comma-separated location filters (matched against the job's locations, case-insensitive).
# Examples: "United States", "Redmond", "India", "Remote". Blank = no location filter.
MSJOBS_LOCATIONS=United States

# Comma-separated keywords the title MUST contain (case-insensitive, OR match). Blank = no filter.
MSJOBS_TITLE_INCLUDES=

# Comma-separated keywords that exclude a job if found in the title (case-insensitive).
MSJOBS_TITLE_EXCLUDES=Intern,Internship

# Only include jobs first posted within this many hours (24 = "posted today").
MSJOBS_MAX_AGE_HOURS=24

# Hard cap on how many jobs end up in a single daily digest.
MSJOBS_MAX_JOBS=15

# How many search-result pages to scan (20 jobs per page).
MSJOBS_MAX_PAGES=4

# Job source: "api" (Microsoft careers JSON API, default) or "playwright"
# (browser fallback — not implemented by default, needs a Premium/container plan).
MSJOBS_SOURCE=api

# --- India edition (second daily digest, on by default) ----------------------
# A separate digest scoped to India, with its own filters + schedule. Set to
# false to disable. All MSJOBS_INDIA_* vars mirror the MSJOBS_* ones above and
# fall back to the same defaults (except locations=India, schedule=09:00 IST).
MSJOBS_INDIA_ENABLED=true
MSJOBS_INDIA_QUERY=Software Engineer
MSJOBS_INDIA_LOCATIONS=India
MSJOBS_INDIA_TITLE_INCLUDES=
MSJOBS_INDIA_TITLE_EXCLUDES=Intern,Internship
MSJOBS_INDIA_MAX_AGE_HOURS=24
MSJOBS_INDIA_MAX_JOBS=15
MSJOBS_INDIA_MAX_PAGES=4
# 03:30 UTC == 09:00 IST
MSJOBS_INDIA_SCHEDULE=0 30 3 * * *

# --- Output / delivery -------------------------------------------------------
# Azure Storage connection string. Required for the Function App (digest output,
# dedup state, and the /api/posts endpoint). Not needed for the local CLI.
AZURE_STORAGE_CONNECTION_STRING=

# Blob container used to store daily digests + dedup state.
MSJOBS_BLOB_CONTAINER=digests

# Timer schedule (NCRONTAB). Default: 07:30 every day. Times are UTC unless
# WEBSITE_TIME_ZONE is set on the Function App.
MSJOBS_SCHEDULE=0 30 7 * * *

# --- Optional email delivery (Azure Communication Services) -------------------
# Leave ACS_CONNECTION_STRING blank to disable email entirely.
ACS_CONNECTION_STRING=
ACS_SENDER_ADDRESS=DoNotReply@your-verified-domain.azurecomm.net
MSJOBS_EMAIL_TO=
